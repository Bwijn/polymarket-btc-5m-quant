# databases / large artifacts
*.db
*.db-journal
*.parquet

# logs
*.log

# python
__pycache__/
*.pyc
*.pyo
.venv/
.python-version
.pytest_cache/

# secrets
.env
.env.*

# claude per-user local settings (memory/rules are committed)
.claude/settings.local.json

# editor / OS
.vscode/
.idea/
.DS_Store

# scratch (mining experiments, hypothesis dirs, factor_lab probes)
# rationale: focus polybot/. scratch is personal workspace, not source-of-truth.
/scratch/

# dev DB workspace (pm_btc5m.db 60GB+, ingested research data, never commit)
/db/

# research data artifacts (parquet/csv/sql — derived, regenerable, never commit)
/research/data/

# research loose top-level scripts = throwaway probes/tools (ignored).
# permanent pipeline lives only in subdirs (features/ ingestion/) → tracked.
/research/*.py

# research/mine/ = mining workspace; ONLY metrics.py (math SSOT) tracked, rest ignored.
# scorecards / dedup / compute = 消费 metrics 的分析脚本 = 本地时间胶囊, git log 不维护.
/research/mine/*
!/research/mine/metrics.py

# research/probe/ = throwaway probe scripts (debug time-capsules, not pipeline) → ignored
/research/probe/

